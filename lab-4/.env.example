# Copy to .env to override. Every value below is already the default.

# Host ports. Shifted off the usual numbers so this project never collides
# with labs 1-2 or anything else already listening on the machine.
WEB_PORT=8090
API_PORT=8020
POSTGRES_PORT=5434

POSTGRES_USER=mt
POSTGRES_PASSWORD=mt
POSTGRES_DB=mt

LOG_LEVEL=INFO

# Automatic dictionary replenishment may consult the MediaWiki API of the
# English Wiktionary. Set to false for a fully offline system: enrichment then
# falls back to derivational rules and practical transcription.
ENRICH_WIKTIONARY_ENABLED=true
