# Lector configuration. `make up` copies this file to .env on first run.
# Every value below is also the built-in default, so an empty .env works too.

# Groq (free tier): Whisper large-v3-turbo for cloud recognition and gpt-oss-20b
# for free-form commands, "explain" and "summarize". Without a key Lector runs fully
# local: Parakeet recognises speech, exact + fuzzy matching handles commands.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Host ports (shifted so they never clash with the other labs).
WEB_PORT=8100
API_PORT=8030

# CPU threads given to speech synthesis; the rest stays free for the desktop.
TTS_THREADS=6
LOG_LEVEL=INFO
