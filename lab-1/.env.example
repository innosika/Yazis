# Copy to `.env` and adjust. Every value here is also the built-in default, so the
# system starts correctly with no .env at all.

# ---- runtime -------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
# `console` is human-readable and colourised; `json` for machine ingestion.
LOG_FORMAT=console

# ---- ports (host side) ---------------------------------------------------------
# Deliberately off the well-known defaults (5432/6379) so this project cannot
# collide with a Postgres or Redis you already run. Only host tools care.
WEB_PORT=8080
API_PORT=8010
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---- database ------------------------------------------------------------------
POSTGRES_USER=irs
POSTGRES_PASSWORD=irs
POSTGRES_DB=irs

# ---- term weighting ------------------------------------------------------------
# Base of the logarithm in B_i = log(N / P_i)  (formula 1.5).
# Ranking is invariant to this choice — the base cancels between the numerator and the
# denominator of the normalized weight w_dk — but it does scale the unnormalized
# keyword weights A_i^j from formula 1.6. Options: e | 2 | 10
INDEX_LOG_BASE=e
INDEX_KEYWORDS_PER_DOCUMENT=20
INDEX_LSA_COMPONENTS=3

# ---- crawler (variant 34: «Сеть Интернет») -------------------------------------
CRAWLER_MAX_PAGES_PER_JOB=500
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_CONCURRENCY=8
CRAWLER_DEFAULT_DELAY_SECONDS=1.0
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MIN_EXTRACTED_CHARS=400

# ---- semantic ranker -----------------------------------------------------------
# Set false to run entirely without dense embeddings; the vector, BM25 and full-text
# rankers are unaffected. Build with BAKE_SEMANTIC_MODEL=0 to also skip the ~130 MB
# model download during `docker build`.
SEMANTIC_ENABLED=true
BAKE_SEMANTIC_MODEL=1

# ---- evaluation ----------------------------------------------------------------
# Pool = union of each ranker's top-EVAL_POOL_DEPTH + the oracle run + a random sample of
# EVAL_POOL_RANDOM_SAMPLE unjudged documents per topic. EVAL_JUDGED_TOPICS topics are
# selected for judging only after the pool (= the frozen runs) exists.
EVAL_POOL_DEPTH=10
EVAL_POOL_RANDOM_SAMPLE=5
EVAL_JUDGED_TOPICS=25
EVAL_RUN_DEPTH=100
EVAL_BINARY_RELEVANCE_THRESHOLD=1

# ---- improvement-proposal rankers ----------------------------------------------
# vector_prf: top-k of the vector run assumed relevant, Rocchio-expanded to this many terms.
SEARCH_PRF_FEEDBACK_DOCS=5
SEARCH_PRF_EXPANSION_TERMS=20

# ---- LLM assessor ----------------------------------------------------------------
# Judges the topical pool. Default: the `ollama` compose service (profile `llm`):
#   make llm-up && make llm-pull      # pulls ~2 GB once into the ollama-models volume
# Any OpenAI-compatible endpoint works instead, e.g.
#   ASSESSOR_LLM_BASE_URL=https://api.openai.com/v1  ASSESSOR_LLM_MODEL=gpt-4o-mini
#   ASSESSOR_LLM_API_KEY=sk-...
OLLAMA_PORT=11435
ASSESSOR_LLM_BASE_URL=http://ollama:11434/v1
ASSESSOR_LLM_MODEL=qwen2.5:3b-instruct
ASSESSOR_LLM_API_KEY=ollama
